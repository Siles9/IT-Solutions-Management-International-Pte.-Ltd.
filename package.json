{
  "name": "business-card-api",
  "version": "1.0.0",
  "description": "Digital business card backend built with NestJS, Prisma, GraphQL and Docker",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,yml,yaml,mjs,mts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,yml,yaml,mjs,mts}\"",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "vitest run test",
    "test:all": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "14.1.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.1.0",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dataloader": "2.2.3",
    "dotenv": "18.0.9",
    "graphql": "16.14.2",
    "helmet": "^8.3.0",
    "pg": "8.16.3",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  }
}
