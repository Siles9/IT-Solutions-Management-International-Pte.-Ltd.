# PostgreSQL connection string used by the Prisma CLI and the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_card?schema=public"

# HTTP port (Apollo Sandbox is served on /, GraphQL on /graphql).
PORT=3000

# development | production (production hides stacktraces in GraphQL errors).
NODE_ENV=development

# When set, mutations require the `x-api-key` HTTP header.
# Leave empty to keep the demo instance writable from Apollo Sandbox.
MUTATION_API_KEY=

# Comma-separated list of allowed CORS origins. Empty = allow any origin.
CORS_ORIGINS=

# Seed the database on startup when the profile does not exist yet.
SEED_ON_START=true

# Set to "debug" to print Prisma SQL queries to the log.
LOG_LEVEL=log
